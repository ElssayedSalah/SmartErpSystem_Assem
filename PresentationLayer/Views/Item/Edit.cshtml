@model BusinessLayer.Models.Inventory.ItemModel

@{
    var Title = _Localization.GetLocalizedHtmlString("UpdateElement") + _Localization.GetLocalizedHtmlString(@Model != null ? Model.GetType().Name : "");
    ViewData["Title"] = Title;
}

<div class="card">  
   
        <form asp-action="Edit" enctype="multipart/form-data">
            <div class="card-header card-header-55">
                @{
                    await Html.RenderPartialAsync("_Edit_Header_Partial");
                    await Html.RenderPartialAsync("_BasicButtonsPartial", this.ViewData["BasicButtons"]);
                }
            </div>
            <div class="card-body card-body-500 justify-content-center d-flex">
                <div class="row w-75">
                    <div class="col-md-8">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        @Html.HiddenFor(x=>x.FinancialPeriodId);
                        <div class="form-group">
                            <label asp-for="Code" class="control-label"></label>
                            <input asp-for="Code" class="form-control" onchange="CreateItemTaxAuthorityCode(this)" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="NameAr" class="control-label"></label>
                            <input asp-for="NameAr" class="form-control" />
                            <span asp-validation-for="NameAr" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="NameEn" class="control-label"></label>
                            <input asp-for="NameEn" class="form-control" />
                            <span asp-validation-for="NameEn" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="GroupId" class="control-label"></label>
                            <select asp-for="GroupId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Groups,"Id","Name",0))"></select>
                            <span asp-validation-for="GroupId" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="DefaultUnit" class="control-label"></label>
                            <select asp-for="DefaultUnit" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Units,"Id","Name",0))"></select>
                            <span asp-validation-for="DefaultUnit" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TypeId" class="control-label"></label>
                            <select asp-for="TypeId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.ItemTypes,"Value","Text",0))"></select>
                            <span asp-validation-for="TypeId" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="SalesPrice" class="control-label"></label>
                            <input asp-for="SalesPrice" class="form-control" />
                            <span asp-validation-for="SalesPrice" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PurchasePrice" class="control-label"></label>
                            <input asp-for="PurchasePrice" class="form-control" />
                            <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TaxAuthorityType" class="control-label"></label>
                            <select asp-for="TaxAuthorityType" class="form-control form-select" asp-items="@(new SelectList(ViewBag.TaxAuthorityTypes,"Value","Text",0))"></select>
                            <span asp-validation-for="TaxAuthorityType" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TaxAuthorityCode" class="control-label"></label>
                            <input asp-for="TaxAuthorityCode" class="form-control" readonly />
                            <span asp-validation-for="TaxAuthorityCode" class="text-danger"></span>
                        </div>
                        <div class="form-group d-none">
                            <label asp-for="ImagePath" class="control-label"></label>
                            <input asp-for="ImagePath" class="form-control" />
                            <span asp-validation-for="ImagePath" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Notes" class="control-label"></label>
                            <input asp-for="Notes" class="form-control" />
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <label asp-for="ActivationState" class="control-label mt-3 ms-1"></label>
                                <input type="checkbox" class="form-check-input" asp-for="ActivationState" />
                            </label>
                        </div>
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <label asp-for="AllowNegativeOut" class="control-label mt-3 ms-1"></label>
                                <input type="checkbox" class="form-check-input" asp-for="AllowNegativeOut" />
                            </label>
                        </div>
                        <input type="hidden" asp-for="TaxAuthorityRegestrationNumber" class="form-control" />

                    </div>
                    <div class="col-md-4 p-4">
                        <img id="ItemImage" class="img-thumbnail w-100 h-100" src="~/Images/@Model.ImagePath" style="max-height:200px;">
                        <label for="ItemImageFile" class="custom-file-upload w-100 text-center form-control mt-2">
                            <i class="fas fa-cloud-upload-alt"></i> @_Localization.GetLocalizedHtmlString("ItemImageFile")
                        </label>
                        <input type="file" id="ItemImageFile" name="ItemImageFile" asp-for="ItemImageFile" accept="image/*" class="form-control d-none" />

                        <label asp-for="BarCode" class="control-label"></label>
                        <div class="img-thumbnail w-100 h-25 mt-2"></div>
                    </div>
                    @await Html.PartialAsync("_BasicDataPartial")
                </div>

            </div>

        </form>
    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#ItemImage').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function CreateItemTaxAuthorityCode(e) {
            debugger
            var code =$(e).val();
            var CompanyTaxAuthorityRegestrationNumber = $("#TaxAuthorityRegestrationNumber").val();
            var itemTaxCode = "EG-" + CompanyTaxAuthorityRegestrationNumber + "-" + code;
            $("#TaxAuthorityCode").val(itemTaxCode);


        }


        $(document).ready(function () {

            $("#ItemImageFile").change(function () {
                readURL(this);
            });

        });

    </script>


}
