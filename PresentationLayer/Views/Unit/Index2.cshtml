@Html.Partial("_Edit_Details_Delete_Partial")
@Html.Partial("_DeleteConfirmationPartial")


@section Scripts {
    @{
        <script>

            $(document).ready(function () {debugger
                var dataSource = new kendo.data.DataSource({
                    /*type: "ajax",*/
                    transport: {
                        read: {
                            url: '/unit/list',
                            type: 'POST',
                            dataType: 'json',

                        }
                    },
                    schema: {
                        data: 'data',
                        model: {
                            fields: {
                                Code: {
                                    type: "string",
                                    label: "الرقم الوظيفي"
                                },
                                NameAr: {
                                    type: "string",
                                    label: "الإسم"
                                },
                            }
                        },
                        total: 'total',
                        errors: 'Errors'
                    },
                    error: function (e) {
                        display_kendoui_grid_error(e);
                        this.cancelChanges();
                    },
                  /*  serverPaging: true,*/
                    serverFiltering: true,
                    serverSorting: true,
                    pageSize: 10
                });
                $("#datatable").kendoGrid(
                    {
                        dataSource: dataSource,
                        schema: {
                            data: 'data',
                            model: {
                                fields: {
                                    code: {
                                        type: "string",
                                        label: "الرقم الوظيفي"
                                    },
                                    nameAr: {
                                        type: "string",
                                        label: "الإسم"
                                    },
                                }
                            },
                            total: 'total',
                            errors: 'Errors'
                        },
                        serverPaging: true,
                        serverFiltering: true,
                        serverSorting: true,
                        //columnMenu: true, //to show or hide column
                        scrollable: false,
                        sortable: true,
                        pageable: {
                            messages: {
                                display: "@_Localization.GetLocalizedHtmlString("عرض") {1} @_Localization.GetLocalizedHtmlString("من") {2}",
                                empty: "No items to display",
                                //page: "Page",
                                //of: "of",
                                itemsPerPage: ""
                            },
                            columnMenu: false,
                            alwaysVisible: true,
                            pageSize: 10,
                            pageSizes: [10, 20, 100]
                        },
                        toolbar: ["search"],
                        search: {
                            fields: [
                                { name: "code", operator: "contains" },
                                { name: "nameAr", operator: "contains" },
                                { name: "nameEn", operator: "contains" },
                            ]
                        },
                        columns: [
                            { field: "id", hidden: true },
                            { field: "code" },
                            { field: "nameAr" },
                            { field: "nameEn" },
                            { field: "creationDate" },
                            { field: "activationState" },
                            {
                                template: "#= CreateCRUDButtons(data) #",
                                with:100
                            },
                        ],
                    }).data("kendoGrid");

                $('.delete-button').on('click', function () {
                    debugger;
                    var id = $(this).data('id');
                    $('#deleteConfirmationModal').modal('show');
                    $('#deleteConfirmationModal form').attr('action', '/@ViewData["ControlerName"]/Delete/' + id);
                });

                $('#dismiss-btn').on('click', function () {
                    $('#deleteConfirmationModal').modal('hide');
                 });

                $("#datatable").removeClass('d-none');

            });
        </script>



