@model BusinessLayer.Models.Inventory.Transaction_InvMasterModel

@{
    var Title = _Localization.GetLocalizedHtmlString("UpdateElement") + _Localization.GetLocalizedHtmlString("StoreSettlement_Transacton");
    ViewData["Title"] = Title;
}
<div class="card">

    <form asp-action="Edit" method="post">
        <div class="card-header card-header-55">
            @{
                <h5 class="float-start"><i class="fa fa-home"></i> @_Localization.GetLocalizedHtmlString("UpdateElement") @_Localization.GetLocalizedHtmlString("StoreSettlement_Transacton")</h5>
                await Html.RenderPartialAsync("_BasicButtonsPartial", this.ViewData["BasicButtons"]);
            }
        </div>
        <div class="card-body card-body-500">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row form-body">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Code" class="control-label"></label>
                        <input asp-for="Code" class="form-control" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="DocDate" class="control-label"></label>
                        <input asp-for="DocDate" class="form-control" readonly/>
                        <span asp-validation-for="DocDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CountDateFrom" class="control-label"></label>
                        <input asp-for="CountDateFrom" class="form-control" readonly/>
                        <span asp-validation-for="CountDateFrom" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="CountDateTo" class="control-label"></label>
                        <input asp-for="CountDateTo" class="form-control" readonly/>
                        <span asp-validation-for="CountDateTo" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="StoreCountNumber" class="control-label"></label>
                        <input asp-for="StoreCountNumber" class="form-control" readonly/>                        
                    </div>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="EntryNumber" class="control-label"></label>
                    <input asp-for="EntryNumber" class="form-control" readonly/>
                    <span asp-validation-for="EntryNumber" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="BranchId" class="control-label"></label>
                    <select asp-for="BranchId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Branches, "Id", "Name", 0))" readonly></select>
                    <span asp-validation-for="BranchId" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="StoreId" class="control-label"></label>
                    <select asp-for="StoreId" class="form-control form-select" readonly></select>
                    <span asp-validation-for="StoreId" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="StoreSurplusValue" class="control-label"></label>
                    <input asp-for="StoreSurplusValue" class="form-control" readonly/>
                    <span asp-validation-for="StoreSurplusValue" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="StoreDeficitValue" class="control-label"></label>
                    <input asp-for="StoreDeficitValue" class="form-control" readonly/>
                    <span asp-validation-for="StoreDeficitValue" class="text-danger"></span>
                </div>
                <div class="form-group col-md-12">
                    <label asp-for="Notes" class="control-label"></label>
                    <input asp-for="Notes" class="form-control" />
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>

            <div class="row mt-2 g-0 table-responsive">
                <table id="datatable" class="table table-responsive table-striped text-start table-bordered border-top">
                    <thead>
                        <tr class="k-header">
                            <th class="k-header">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("ItemModel"))
                            </th>
                            <th class="k-header">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("ItemGroup"))
                            </th>
                            <th class="k-header">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("DefaultUnit"))
                            </th>
                            <th class="k-header" style="width: 150px;">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("Quntity"))
                            </th>
                            <th class="k-header" style="width: 150px;">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("ActualQuntity"))
                            </th>
                            <th class="k-header" style="width: 150px;">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("DifferenceQuntity"))
                            </th>
                            <th class="k-header" style="width: 150px;">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("UnitCoast"))
                            </th>
                            <th class="k-header" style="width: 150px;">
                                @Html.DisplayName(@_Localization.GetLocalizedHtmlString("TotalCoast"))
                            </th>

                        </tr>
                    </thead>
                    <tbody id="Details">

                        @for (int i = 0; i < Model.Transaction_InvDetails.Count(); i++)
                        {
                            var templateClass = i == 0 ? "TemplateRow" : "";
                        <tr class="NewRow @templateClass">
                            <td class="ItemIdSelect">
                                <select asp-for="@Model.Transaction_InvDetails[i].ItemId" class="form-control form-select item_row" asp-items="@(new SelectList(ViewBag.Itmes, "Id", "Name",@Model.Transaction_InvDetails[i].ItemId))" value="@Model.Transaction_InvDetails[i].ItemId" readonly></select>
                            </td>
                            <td class="GroupIdSelect">
                                <select asp-for="@Model.Transaction_InvDetails[i].GroupId" class="form-control form-select group_row" asp-items="@(new SelectList(ViewBag.Groups, "Id", "Name"))" readonly></select>

                            </td>
                            <td class="UnitIdSelect">
                                <select asp-for="@Model.Transaction_InvDetails[i].UnitId" class="form-control form-select unit_row" asp-items="@(new SelectList(ViewBag.Units, "Id", "Name"))" readonly></select>
                            </td>
                            <td class="QuntitySelector">
                                <input asp-for="@Model.Transaction_InvDetails[i].Quntity" value="@Model.Transaction_InvDetails[i].Quntity" class="form-control k-text-negative qty_row" style="text-align:center;" readonly/>
                            </td>
                            <td class="ActualQuntitySelector">
                                <input asp-for="@Model.Transaction_InvDetails[i].ActualQuntity" value="@Model.Transaction_InvDetails[i].ActualQuntity" class="form-control k-text-negative ActualQuntity_row" style="text-align:center;" onchange="GetDifferenceQuntity(this);" readonly/>
                            </td>
                            <td class="DifferenceQuntitySelector">
                                <input asp-for="@Model.Transaction_InvDetails[i].DifferenceQuntity" value="@Model.Transaction_InvDetails[i].DifferenceQuntity" class="form-control k-text-negative DifferenceQuntity_row" style="text-align:center;" onchange="GetTotalCoast(this);" readonly/>
                            </td>
                            <td class="PurchasePriceSelector">
                                <input asp-for="@Model.Transaction_InvDetails[i].PurchasePrice" value="@Model.Transaction_InvDetails[i].PurchasePrice" class="form-control k-text-negative PurchasePrice_row" style="text-align:center;" readonly/>
                            </td>
                            <td class="TotalSelector">
                                <input asp-for="@Model.Transaction_InvDetails[i].Total" value="@Model.Transaction_InvDetails[i].Total" class="form-control k-text-negative Total_row" style="text-align:center;" readonly/>
                            </td>
                        </tr>

                        }
                    </tbody>
                </table>
            </div>

        </div>

        @await Html.PartialAsync("_BasicDataPartial")

    </form>
</div>


<style>
    .TemplateRow {
        display: none;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

        <script>

            $(document).ready(function () {
               
                 var DocDate = @Html.Raw(Json.Serialize(Model.DocDate));
                CreatekendoDateTimePickert($("#DocDate"), false, '', '', "yyyy-MM-dd hh:mm tt", DocDate);

                var CountDateFrom = @Html.Raw(Json.Serialize(Model.CountDateFrom));
                CreatekendoDateTimePickert($("#CountDateFrom"), false, '', '', "yyyy-MM-dd hh:mm tt", CountDateFrom);

                var CountDateTo = @Html.Raw(Json.Serialize(Model.CountDateTo));
                CreatekendoDateTimePickert($("#CountDateTo"), false, '', '', "yyyy-MM-dd hh:mm tt", CountDateTo);


                CreateNumericUpDown($("#Code"), 0, '', true);
                CreateNumericUpDown($("#StoreSurplusValue"), 2, '', true);
                CreateNumericUpDown($("#StoreDeficitValue"), 2, '', true);

              $("#BranchId").change(function (e) {
                    let BranchId = $(this).val();
                  $.ajax({
                  type: 'GET',
                  url: '/StoreSettlement/GetBranchStores/',
                  data: { BranchId: BranchId },
                  contentType: 'application/json; charset=utf-8',
                  datatype: 'json',
                      success: function (data) {
                  FillDropDown($("#@Html.IdFor(x=>x.StoreId)"), data, '@_Localization.GetLocalizedHtmlString("Select")', '@Model.StoreId')
            }
        });
              }).change();

            });

            function GetDifferenceQuntity(e) {
                debugger
                var ActualQuntity = $(e).val();
                var CurruntQuntity = $(e).closest(".NewRow").find(".qty_row input").last().val();
                let dif = ActualQuntity - CurruntQuntity;
                $(e).closest(".NewRow").find(".DifferenceQuntity_row input").last().data("kendoNumericTextBox").value(dif);
                $(e).closest(".NewRow").find(".DifferenceQuntity_row input").last().change();
            }

            function GetTotalCoast(e) {
                var DifferenceQuntity = $(e).val();
                var PurchasePrice = $(e).closest(".NewRow").find(".PurchasePrice_row input").last().val();
                let Total = DifferenceQuntity * PurchasePrice;
                $(e).closest(".NewRow").find(".Total_row input").last().data("kendoNumericTextBox").value(Total);

            }
            function GetDeficitAndSurplusValue() {
                debugger
                var DeficitValue = 0;
                var SurplusValue = 0;
                var Coasts = $(".NewRow:not(.TemplateRow) .TotalSelector");

                $(Coasts).each(function (i, c) {
                    debugger
                    var coast = $(c).closest(".NewRow").find(".Total_row input").last().data("kendoNumericTextBox").value();
                    if (coast > 0) {
                        SurplusValue += coast;
                    }
                    if (coast < 0) {
                        DeficitValue += Math.abs(coast);
                    }
                });

                $("#StoreSurplusValue").data("kendoNumericTextBox").value(SurplusValue);
                $("#StoreDeficitValue").data("kendoNumericTextBox").value(DeficitValue);
            }

        </script>
    }
}