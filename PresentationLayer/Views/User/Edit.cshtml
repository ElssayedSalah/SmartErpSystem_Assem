@model BusinessLayer.Models.Identity.UserModel

@{
    ViewData["Title"] = "Edit";
}
<div class="card">
  
        <form asp-action="Edit">
            <div class="card-header card-header-55">
                @{
                    await Html.RenderPartialAsync("_Edit_Header_Partial");
                    await Html.RenderPartialAsync("_BasicButtonsPartial", this.ViewData["BasicButtons"]);
                }
            </div>
            <div class="card-body card-body-500 justify-content-center d-flex">
                <div class="row w-75">
                    <input type="hidden" asp-for="Id" class="form-control" />
                    @*<div class="col-md-4 p-4">
            @{await Html.RenderPartialAsync("_InventoryBasicsImagePartail");}
        </div>*@
                <div class="col-lg-12 col-md-10 col-sm-8">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="UserName" class="control-label"></label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label" for="userpassword"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="userpassword">
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="form-label" for="Email"></label>
                        <input asp-for="Email" type="email" class="form-control" id="Email">
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="BranchId" class="control-label"></label>
                        <select id="mainGroupSelectid" asp-for="BranchId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Branches,"Id","Name",0))"></select>
                        <span asp-validation-for="BranchId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="EmployeeId" class="form-label" for=""></label>
                        <input asp-for="EmployeeId" type="text" class="form-control" id="">
                        <span asp-validation-for="EmployeeId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CompanyId" class="form-label" for=""></label>
                        <select asp-for="CompanyId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Companies,"Id","Name",0))"></select>
                        <span asp-validation-for="CompanyId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RoleId" class="control-label"></label>
                        <select id="RoleIdss" asp-for="RoleId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.RoleIds,"Id","Name",0))"></select>
                        <span asp-validation-for="RoleId" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <label asp-for="ActivationState" class="control-label mt-3 ms-1"></label>
                            <input type="checkbox" class="form-check-input" asp-for="ActivationState" />
                        </label>
                    </div>
                </div>
                </div>

            </div>

        </form>
   
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}


}
