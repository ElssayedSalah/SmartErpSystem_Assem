@model IEnumerable<BusinessLayer.Models.Financial.FinancialPeriodModel>

@{
    ViewData["Title"] = "Index";
}
<div class="card">
    <div class="card-header card-header-55">
        <h5><i class="fa fa-list p-1"></i>@_Localization.GetLocalizedHtmlString("FinancialPeriodClose")</h5>       
    </div>
    <div class="card-body card-body-500">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Year)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateFrom)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.DateTo)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Year)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DateFrom)

                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DateTo)
                        </td>

                        <td class="float-end">
                            @Html.ActionLink(_Localization.GetLocalizedHtmlString("TempClose"), "TempClose", new { id = item.Id }, new { @class = "btn btn-primary" }) |
                            @Html.ActionLink(_Localization.GetLocalizedHtmlString("FinalClose"), "FinalClose", new { id = item.Id }, new { @class = "btn btn-danger" })
                            <!--<button id="FinalClose" class="btn btn-danger" type="button">-->@*@_Localization.GetLocalizedHtmlString("FinalClose")*@<!--</button>-->

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
