                                } else if (data.msgType == "erorr") {
                                    ShowErrorMessege(data.msg)
                                }

                            }
                        }
                    },
                    complete: function () {

                        $('.btn1').prop('disabled', false);

                    }
                });

            });

            $("#TransferTreasurys").click(function () {

                $('.btn1').prop('disabled', true);
                var CuruntPeriodId = $("#CuruntPeriodId").val();
                $.ajax({
                    url: '/FinancialPeriodClose/TransferTreasurys/',
                    data: { CuruntPeriodId: CuruntPeriodId },
                    success: function (data) {

                        if (data != null) {
                            if (data != null) {
                                if (data.msgType == "success") {
                                    ShowSuccessMessege(data.msg);

                                } else if (data.msgType == "erorr") {
                                    ShowErrorMessege(data.msg)
                                }

                            }
                        }
                    },
                    complete: function () {

                        $('.btn1').prop('disabled', false);

                    }
                });

            });

            $("#TransferBanks").click(function () {

                $('.btn1').prop('disabled', true);
                var CuruntPeriodId = $("#CuruntPeriodId").val();
                $.ajax({
                    url: '/FinancialPeriodClose/TransferBanks/',
                    data: { CuruntPeriodId: CuruntPeriodId },
                    success: function (data) {

                        if (data != null) {
                            if (data != null) {
                                if (data.msgType == "success") {
                                    ShowSuccessMessege(data.msg);

                                } else if (data.msgType == "erorr") {
                                    ShowErrorMessege(data.msg)
                                }

                            }
                        }
                    },
                    complete: function () {

                        $('.btn1').prop('disabled', false);

                    }
                });

            });

            $("#TransferAccounts").click(function () {

                $('.btn1').prop('disabled', true);
                var CuruntPeriodId = $("#CuruntPeriodId").val();
                $.ajax({
                    url: '/FinancialPeriodClose/TransferAccounts/',
                    data: { CuruntPeriodId: CuruntPeriodId },
                    success: function (data) {

                        if (data != null) {
                            if (data != null) {
                                if (data.msgType == "success") {
                                    ShowSuccessMessege(data.msg);

                                } else if (data.msgType == "erorr") {
                                    ShowErrorMessege(data.msg)
                                }

                            }
                        }
                    },
                    complete: function () {

                        $('.btn1').prop('disabled', false);

                    }
                });

            });

        });



    </script>

}



