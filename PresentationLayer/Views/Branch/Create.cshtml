@model BusinessLayer.Models.Inventory.BranchModel

@{
    ViewData["Title"] = "Create";
}

<div class="card">   
        <form asp-action="Create">
            <div class="card-header card-header-55">
                @{
                    await Html.RenderPartialAsync("_Create_Header_Partial");
                    await Html.RenderPartialAsync("_BasicButtonsPartial", this.ViewData["BasicButtons"]);
                }
            </div>
            <div class="card-body card-body-500 justify-content-center d-flex">    
                <div class="row w-75">                   
                    <div class="col-lg-12 col-md-10 col-sm-8">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="Code" class="control-label"></label>
                            <input asp-for="Code" class="form-control" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="NameAr" class="control-label"></label>
                            <input asp-for="NameAr" class="form-control" />
                            <span asp-validation-for="NameAr" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="NameEn" class="control-label"></label>
                            <input asp-for="NameEn" class="form-control" />
                            <span asp-validation-for="NameEn" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="TaxAuthorityCode" class="control-label"></label>
                            <input asp-for="TaxAuthorityCode" class="form-control" />
                            <span asp-validation-for="TaxAuthorityCode" class="text-danger"></span>
                        </div>
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <label asp-for="ActivationState" class="control-label mt-3 ms-1"></label>
                                <input type="checkbox" class="form-check-input" asp-for="ActivationState" />
                            </label>
                        </div>
                    </div>
                </div>



