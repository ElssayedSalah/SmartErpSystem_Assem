            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CompanyId)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Notes)
            </dt>
            <dd class="col-sm-10">
