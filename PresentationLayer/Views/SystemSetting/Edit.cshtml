@model BusinessLayer.Models.System.SystemSettingModel

@{
    ViewData["Title"] = "Edit";
}
    
<div class="card">
    <form asp-action="Edit">
        <div class="card-header card-header-55">
            @{
                await Html.RenderPartialAsync("_Edit_Header_Partial");
                await Html.RenderPartialAsync("_BasicButtonsPartial", this.ViewData["BasicButtons"]);
            }
        </div>
        <div class="card-body card-body-500 justify-content-center d-flex">
            <div class="row w-75">
                <div class="col-lg-12 col-md-10 col-sm-8">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="IdentityService_Url" class="control-label"></label>
                        <input asp-for="IdentityService_Url" class="form-control" />
                        <span asp-validation-for="IdentityService_Url" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="System_APIUrl" class="control-label"></label>
                        <input asp-for="System_APIUrl" class="form-control" />
                        <span asp-validation-for="System_APIUrl" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="E_InvoiceType" class="control-label"></label>
                        <select asp-for="E_InvoiceType" class="form-control form-select" asp-items="@(new SelectList(ViewBag.InvoiceTypes,"Value","Text"))"></select>
                        <span asp-validation-for="E_InvoiceType" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <label asp-for="EnableOpenEntryCreation" class="control-label mt-3 ms-1"></label>
                            <input type="checkbox" class="form-check-input" asp-for="EnableOpenEntryCreation" />
                        </label>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <label asp-for="EnableTransactionsEntryCreation" class="control-label mt-3 ms-1"></label>
                            <input type="checkbox" class="form-check-input" asp-for="EnableTransactionsEntryCreation" />
                        </label>
                    </div>
                </div>
            </div>
        </div>

    </form>

</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
