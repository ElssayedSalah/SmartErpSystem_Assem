@model BusinessLayer.Models.Financial.TransactionsEntrySettingMasterModel

@{
    ViewData["Title"] = "Index";
    ViewData["ControlerName"] = "TransactionsEntrySetting";
}

<div class="card">
    <div class="card-header card-header-55">
        <div class="row">
            <div class="col-lg-8 col-md-6 col-sm-8"><h5><i class="fa fa-list p-1"></i>@_Localization.GetLocalizedHtmlString("List")   @_Localization.GetLocalizedHtmlString("TransactionsEntrySetting")</h5></div>
            <div class="col-lg-4 col-md-6 col-sm-4">
                <a asp-action="Create" class="btn btn-success float-end">
                    <i class="fas fa-plus icon"></i>
                    @_Localization.GetLocalizedHtmlString("CreateNew")
                </a>
            </div>
        </div>

    </div>

    <div class="card-body card-body-500">
        <div id="datatable"></div>
    </div>
</div>
@section Scripts {
    @{

        <script>

            $(document).ready(function () {
                var gridOperationButtons = GridOperationButtons('@ViewData["ControlerName"]');
                var dataSource = intializeKendoGrid('/TransactionsEntrySetting/list');
                $("#datatable").kendoGrid(
                    {
                        dataSource: dataSource,
                        serverFiltering: false,
                        serverSorting: true,
                        scrollable: false,
                        sortable: true,
                        pageable: {
                            messages: {
                                display: "@_Localization.GetLocalizedHtmlString("shared.show") {1} @_Localization.GetLocalizedHtmlString("shared.from") {2}",
                                empty: "@_Localization.GetLocalizedHtmlString("shared.empty.grid")",
                                itemsPerPage: ""
                            },
                            columnMenu: false,

                            pageSize: 10,
                            pageSizes: [10, 20, 100]
                        },
                        toolbar: ["search"],
                        search: {
                            fields: [
                                { name: "Id", operator: "contains" },
                                { name: "DocTypeName", operator: "contains" },
                                
                            ]
                        },
                        columns: [
                           { field: "Id", hidden: true },
                           { field: "DocTypeName",title:"@_Localization.GetLocalizedHtmlString("DocType")"  },
                          
                           
                            gridOperationButtons[1],
                            gridOperationButtons[2],

                        ],
                    });
            });

        </script>

    }
}
