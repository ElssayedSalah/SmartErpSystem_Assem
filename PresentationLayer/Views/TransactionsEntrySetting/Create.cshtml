
@model BusinessLayer.Models.Financial.TransactionsEntrySettingMasterModel

@{
    ViewData["Title"] = "Create";

}

@Html.AntiForgeryToken()
<div class="card">
    <form asp-action="Create" id="myform">
        <div class="card-header card-header-55">
            <div class="row">
                <div class="col-lg-8 col-md-6 col-sm-8"><h5><i class="fa fa-list p-1"></i>@_Localization.GetLocalizedHtmlString("TransactionsEntrySetting")</h5></div>
               
                <div class="col-lg-4 col-md-6 col-sm-4">
                    <a asp-controller="TransactionsEntrySetting" asp-action="Index" class="btn btn-info  float-end m-1">
                        <i class="fas fa-th-list icon"></i>
                        @_Localization.GetLocalizedHtmlString("BackToList")
                    </a>
                    <button type="submit" id="btnSave" class="btn btn-success float-end m-1">
                        <i class="fas fa-check button-icon"></i>
                        @_Localization.GetLocalizedHtmlString("Save")
                    </button>

                </div>
                    
                </div>
        </div>
        <div class="card-body card-body-500 justify-content-center d-flex">
            <div class="row w-75">
                <div class="col-lg-12 col-md-10 col-sm-8">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group col-md-12">
                        <label asp-for="DocTypeId" class="control-label"></label>
                        <select asp-for="DocTypeId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Documents, "DocTypeId", "Name", 0))"></select>
                        <span asp-validation-for="DocTypeId" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-12">
                        <label asp-for="DailyTypeId" class="control-label"></label>
                        <select asp-for="DailyTypeId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.DailyAccounts, "Id", "Name", 0))"></select>
                        <span asp-validation-for="DailyTypeId" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-4">
                            <label asp-for="FirstSideIds" class="control-label"></label>
                            <select asp-for="FirstSideIds" class="form-control form-select kendo-multi-select" asp-items="@(new SelectList(ViewBag.SideTypes,"Value","Text"))"></select>
                            <span asp-validation-for="FirstSideIds" class="text-danger"></span>
                        </div>
                        <div class="form-group col-md-4">
                            <label asp-for="FirstSideSideNaturalId" class="control-label"></label>
                            <select asp-for="FirstSideSideNaturalId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.SideNatural,"Value","Text"))"></select>
                            <span asp-validation-for="FirstSideSideNaturalId" class="text-danger"></span>
                        </div>
                        <div class="form-group form-check col-md-4 pt-4">
                            <label class="form-check-label">
                                <label asp-for="IsFirstSideTaxble" class="control-label mt-3 ms-1"></label>
                                <input type="checkbox" class="form-check-input" asp-for="IsFirstSideTaxble" onchange="FirstSideTaxbleChange(this)" />
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-4">
                            <label asp-for="SecondSideIds" class="control-label"></label>
                            <select asp-for="SecondSideIds" class="form-control form-select" asp-items="@(new SelectList(ViewBag.SideTypes,"Value","Text"))"></select>
                            <span asp-validation-for="SecondSideIds" class="text-danger"></span>
                        </div>

                        <div class="form-group col-md-4">
                            <label asp-for="SecondSideSideNaturalId" class="control-label"></label>
                            <select asp-for="SecondSideSideNaturalId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.SideNatural,"Value","Text"))"></select>
                            <span asp-validation-for="SecondSideSideNaturalId" class="text-danger"></span>
                        </div>
                        <div class="form-group form-check col-md-4 pt-4">
                            <label class="form-check-label">
                                <label asp-for="IsSecondSideTaxble" class="control-label mt-3 ms-1"></label>
                                <input type="checkbox" class="form-check-input" asp-for="IsSecondSideTaxble" onchange="SecondSideTaxbleChange(this)" />
                            </label>
                        </div>
                    </div>

                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <label asp-for="TransferState" class="control-label mt-3 ms-1"></label>
                            <input type="checkbox" class="form-check-input" asp-for="TransferState" />
                        </label>
                    </div>
                   
                </div>
            </div>
        </div>
        @*@Html.HiddenFor(x => x.Id)*@
    </form>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

        <script>           
            $(document).ready(function () {

                $("#FirstSideIds").data('kendoDropDownList').destroy();
                $("#FirstSideIds").closest('.k-widget').html(document.getElementById("FirstSideIds"));
                $("#FirstSideIds").closest('.k-widget').attr('class', '');
                InitMultiSelect("#FirstSideIds");

                $("#SecondSideIds").data('kendoDropDownList').destroy();
                $("#SecondSideIds").closest('.k-widget').html(document.getElementById("SecondSideIds"));
                $("#SecondSideIds").closest('.k-widget').attr('class', '');
                InitMultiSelect("#SecondSideIds");

            });


                
         
            $("#btnSave").click(function (e)
            {
                 var DocTypeId= $("#DocTypeId").val()
                var FirstSide = $("#FirstSide").val()
                var SecondSide=  $("#SecondSide").val()
                var DailyTypeId= $("#DailyTypeId").val()
                debugger
                if (DocTypeId == 0)
                {
                    
                    e.preventDefault();
                    ShowErrorMessege("@_Localization.GetLocalizedHtmlString("DocTypeRequired")")

                }
                else if (DailyTypeId == 0)
                {
                    e.preventDefault();
                    ShowErrorMessege("@_Localization.GetLocalizedHtmlString("DailyTypeIdRequired")")

                }
                else if (FirstSide == 0) {
                    e.preventDefault();
                    ShowErrorMessege("@_Localization.GetLocalizedHtmlString("FirstSideRequired")")

                }
                else if (SecondSide == 0) {
                    e.preventDefault();
                    ShowErrorMessege("@_Localization.GetLocalizedHtmlString("SecondSideRequired")")

                }
            })


            function FirstSideTaxbleChange(e) {
                if ($(e).is(':checked')) {
                    $("#IsSecondSideTaxble").prop('checked', false);
                    $("#IsSecondSideTaxble").val('False');
                }
            }
            function SecondSideTaxbleChange(e) {
                if ($(e).is(':checked')) {
                    $("#IsFirstSideTaxble").prop('checked', false);
                    $("#IsFirstSideTaxble").val('False');
                }
            }

        </script>
    }



}


