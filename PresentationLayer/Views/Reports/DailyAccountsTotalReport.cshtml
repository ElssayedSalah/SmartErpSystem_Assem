@model BusinessLayer.Models.Filters.DailyAccountsTotalReportFilters
@{
    //page title
    Layout = "~/Views/Shared/_ReportsLayout.cshtml";
    ViewBag.Title = _Localization.GetLocalizedHtmlString("DailyAccountsTotalReport").Value;
}

@Html.HiddenFor(model => model.ExportType)
<div class="row">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group col-md-4">
        <label asp-for="AccountId" class="control-label"></label>
        <select asp-for="AccountId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Accounts, "Id", "Name", 0))"></select>
        <span asp-validation-for="AccountId" class="text-danger"></span>
    </div>
    <div class="form-group col-md-4">
        <label asp-for="CoastCenterId" class="control-label"></label>
        <input asp-for="CoastCenterId" class="form-control" />
    </div>
    <div class="form-group col-md-4">
        <label asp-for="DailyAccountsId" class="control-label"></label>
        <select asp-for="DailyAccountsId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.DailyAccounts, "Id", "Name", 0))"></select>
    </div>    
    <div class="form-group col-md-4">
        <label asp-for="FromDate" class="control-label"></label>
        <input asp-for="FromDate" class="form-control" />
    </div>
    <div class="form-group col-md-4">
        <label asp-for="ToDate" class="control-label"></label>
        <input asp-for="ToDate" class="form-control" />
    </div>


</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

        <script>
            $(document).ready(function () {
                var FromDate = @Html.Raw(Json.Serialize(Model.FromDate));
                var ToDate = @Html.Raw(Json.Serialize(Model.ToDate));
                CreateDatePickerWithElment($("#FromDate"), false, '', '', "yyyy-MM-dd", FromDate);
                CreateDatePickerWithElment($("#ToDate"), false, '', '', "yyyy-MM-dd", ToDate);


            });
        </script>

    }


}


