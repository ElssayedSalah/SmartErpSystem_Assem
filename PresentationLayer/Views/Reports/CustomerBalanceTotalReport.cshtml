@model BusinessLayer.Models.Filters.CustomerBalanceTotalReportFilters
@{
    //page title
    Layout = "~/Views/Shared/_ReportsLayout.cshtml";
    ViewBag.Title = _Localization.GetLocalizedHtmlString("CustomerBalanceTotalReport").Value;
}

@Html.HiddenFor(model => model.ExportType)
<div class="row">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group col-md-3">
        <label asp-for="CustomerId" class="control-label"></label>
        <select asp-for="CustomerId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Customers, "Id", "Name", 0))"></select>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="BranchId" class="control-label"></label>
        <select asp-for="BranchId" class="form-control form-select" asp-items="@(new SelectList(ViewBag.Branches, "Id", "Name", 0))"></select>
    </div>
    <div class="form-group col-md-3">
        <label asp-for="FromDate" class="control-label"></label>
        <input asp-for="FromDate" class="form-control" />
    </div>
    <div class="form-group col-md-3">
        <label asp-for="ToDate" class="control-label"></label>
        <input asp-for="ToDate" class="form-control" />
    </div>

</div>

@section Scripts {
    <script>
            $(document).ready(function () {
                CreateDatePickerWithElment($("#FromDate"), false, '', '');
                CreateDatePickerWithElment($("#ToDate"), false, '', '');

            });
    </script>

}


