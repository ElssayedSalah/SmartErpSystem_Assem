@model BusinessLayer.Models.Identity.RoleModel

@{
    ViewData["Title"] = "Edit";
}
<div class="card">    
        <form asp-action="Edit">
            <div class="card-header card-header-55">
                @{
                    await Html.RenderPartialAsync("_Edit_Header_Partial");
                    await Html.RenderPartialAsync("_BasicButtonsPartial", this.ViewData["BasicButtons"]);
                }
            </div>
            <div class="card-body card-body-500 justify-content-center d-flex">             
                <div class="row w-75">
                    @*<div class="col-md-4 p-4">
            @{await Html.RenderPartialAsync("_InventoryBasicsImagePartail");}
        </div>*@
                    <div class="col-lg-12 col-md-10 col-sm-8">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="NameAr" class="control-label"></label>
                            <input asp-for="NameAr" class="form-control" />
                            <span asp-validation-for="NameAr" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Name" class="control-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Notes" class="control-label"></label>
                            <input asp-for="Notes" class="form-control" />
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                        <div class="col-12" style="display:-webkit-inline-box;">
                            <div class="col-4">
                                <div class="form-group form-check">
                                    <label class="form-check-label">
                                        <label asp-for="ActivationState" class="control-label mt-3 ms-1"></label>
                                        <input type="checkbox" class="form-check-input" asp-for="ActivationState" />
                                    </label>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="form-group form-check">
                                    <label class="form-check-label">
                                        <label asp-for="IsSystemRole" class="control-label mt-3 ms-1"></label>
                                        <input type="checkbox" class="form-check-input" asp-for="IsSystemRole" />
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
             
            </div>

        </form>
    
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
