@using DataAccessLayer.Entities.Identity
@using DataAccessLayer.Entities.Inventory;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _HttpContextAccessor;
@inject IBaseService<Branch> _BranchService;
<style>
    .stretched-image {
        width: 100%;
        height: 69px;
        max-height: 100px;
    }
</style>
<header id="page-topbar">
    <div class="navbar-header">
        <div class="d-flex">
            <!-- LOGO -->
            <div class="navbar-brand-box">
                @*<a asp-controller="Home" asp-action="Dashpoard2" class="logo logo-dark">
                <span class="logo-sm">
                    <img src="~/AdminLayout2/assets/images/logo-sm.png" alt="" height="22">
                </span>
                <span class="logo-lg">
                    <img src="~/AdminLayout2/assets/images/logo-dark.png" alt="" height="17">
                </span>
            </a>*@

                <a asp-controller="Home" asp-action="Dashpoard2" class="logo logo-light">
                    <span class="logo-sm">
                        <img class="stretched-image" src="~/AdminLayout2/assets/images/erplogo2.png" alt="">
                    </span>
                    <span class="logo-lg text-light">
                        <img class="stretched-image" src="~/AdminLayout2/assets/images/erplogo2.png" alt="">
                        @*<em id="companyid" class="logo-lg text-light">@(_HttpContextAccessor.HttpContext.Session.GetCompanyData<CompanyMobel>("CompanyData")?.Name)</em>*@
                        @*<img src="~/AdminLayout2/assets/images/logo-light.png" alt="" height="18">*@
                    </span>
                </a>
            </div>

            <button type="button" class="btn btn-sm px-3 font-size-24 header-item waves-effect" id="vertical-menu-btn">
                <i class="mdi mdi-menu"></i>
            </button>


            @{
                var BranchName = "";
                if (_HttpContextAccessor.HttpContext.Session.GetCurrentUser<ApplicationUser>("CurrentUser").BranchId.HasValue)
                {
                    var branch = _BranchService.GetById(_HttpContextAccessor.HttpContext.Session.GetCurrentUser<ApplicationUser>("CurrentUser").BranchId.Value);
                    if (branch != null)
                    {
                        var currentLanguage = Thread.CurrentThread.CurrentCulture.Name;
                        BranchName = currentLanguage == "ar" ? branch.NameAr : branch.NameEn;
                        <div class="text-center pt-4"> @BranchName</div>
                    }
                }
                }
        </div>
                   

        <div class="d-flex">
            <!-- App Search-->
            <form class="app-search d-none d-lg-block">
                <div class="position-relative">
                    <input type="text" class="form-control" placeholder="@_Localization.GetLocalizedHtmlString("shared.search")">
                    <span class="fa fa-search"></span>
                </div>
            </form>


            @await Html.PartialAsync("_SetLanguagePartial2")

            <div class="dropdown d-none d-lg-inline-block" title="السنة المالية">
                <button type="button" class="btn header-item noti-icon waves-effect" data-bs-toggle="">
                    <span>@(_HttpContextAccessor.HttpContext.Session.GetCurrentUser<ApplicationUser>("CurrentUser")?.FinancialPeriod)</span>
                </button>
            </div>

            <div class="dropdown d-inline-block">
                <button type="button" class="btn header-item noti-icon waves-effect" id="page-header-notifications-dropdown"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="mdi mdi-bell-outline"></i>
                    <span class="badge bg-danger rounded-pill">3</span>
                </button>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdown">
                    <div class="p-3">
                        <div class="row align-items-center">
                            <div class="col">
                                <h5 class="m-0 font-size-16"> Notifications (258) </h5>
                            </div>
                        </div>
                    </div>
                    <div data-simplebar style="max-height: 230px;">
                        <a href="" class="text-reset notification-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar-xs">
                                        <span class="avatar-title bg-success rounded-circle font-size-16">
                                            <i class="mdi mdi-cart-outline"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">Your order is placed</h6>
                                    <div class="font-size-12 text-muted">
                                        <p class="mb-1">Dummy text of the printing and typesetting industry.</p>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <a href="" class="text-reset notification-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar-xs">
                                        <span class="avatar-title bg-warning rounded-circle font-size-16">
                                            <i class="mdi mdi-message-text-outline"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">New Message received</h6>
                                    <div class="font-size-12 text-muted">
                                        <p class="mb-1">You have 87 unread messages</p>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <a href="" class="text-reset notification-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar-xs">
                                        <span class="avatar-title bg-info rounded-circle font-size-16">
                                            <i class="mdi mdi-glass-cocktail"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">Your item is shipped</h6>
                                    <div class="font-size-12 text-muted">
                                        <p class="mb-1">It is a long established fact that a reader will</p>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <a href="" class="text-reset notification-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar-xs">
                                        <span class="avatar-title bg-primary rounded-circle font-size-16">
                                            <i class="mdi mdi-cart-outline"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">Your order is placed</h6>
                                    <div class="font-size-12 text-muted">
                                        <p class="mb-1">Dummy text of the printing and typesetting industry.</p>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <a href="" class="text-reset notification-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar-xs">
                                        <span class="avatar-title bg-danger rounded-circle font-size-16">
                                            <i class="mdi mdi-message-text-outline"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">New Message received</h6>
                                    <div class="font-size-12 text-muted">
                                        <p class="mb-1">You have 87 unread messages</p>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="p-2 border-top">
                        <div class="d-grid">
                            <a class="btn btn-sm btn-link font-size-14 text-center" href="javascript:void(0)">
                                View all
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @if (_IdentityService.IsSignedInUser(User))
            {
                <div class="dropdown d-inline-block">
                    <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                            data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <img class="rounded-circle header-profile-user" src="~/AdminLayout2/assets/images/users/user-4.jpg"
                             alt="Header Avatar">
                        @_Localization.GetLocalizedHtmlString("LoginWelcomeMsg"): @User.Identity.Name
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <!-- item-->
                        <a class="dropdown-item" href="#"><i class="mdi mdi-account-circle font-size-17 align-middle me-1"></i> Profile</a>
                        @*<a class="dropdown-item" href="#"><i class="mdi mdi-wallet font-size-17 align-middle me-1"></i> My Wallet</a>
                            <a class="dropdown-item d-flex align-items-center" href="#"><i class="mdi mdi-cog font-size-17 align-middle me-1"></i> Settings<span class="badge bg-success ms-auto">11</span></a>
                            <a class="dropdown-item" href="#"><i class="mdi mdi-lock-open-outline font-size-17 align-middle me-1"></i> Lock screen</a>*@
                        <div class="dropdown-divider"></div>
                        <form method="post" asp-action="LogOut" asp-controller="Account">
                            <button type="submit" class="dropdown-item text-danger bx bx-power-off font-size-17 align-middle me-1 text-danger"><i class="mdi mdi-lock-open-outline font-size-17 align-middle me-1"></i> Log Out</button>
                        </form>
                    </div>
                </div>

            }


            <div class="dropdown d-inline-block">
                <button type="button" class="btn header-item noti-icon right-bar-toggle waves-effect">
                    <i class="mdi mdi-cog-outline"></i>
                </button>
            </div>

        </div>
    </div>
</header>





