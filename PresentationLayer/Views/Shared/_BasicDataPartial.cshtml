@model BusinessLayer.Models.Model
<div class="visually-hidden">
    <div class="form-group">
        <label asp-for="Id" class="control-label"></label>
        <input asp-for="Id" class="form-control" />
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CreationDate" class="control-label"></label>
        <input asp-for="CreationDate" class="form-control" />
        <span asp-validation-for="CreationDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UpdatedDate" class="control-label"></label>
        <input asp-for="UpdatedDate" class="form-control" />
        <span asp-validation-for="UpdatedDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="CreationUserId" class="control-label"></label>
        <input asp-for="CreationUserId" class="form-control" />
        <span asp-validation-for="CreationUserId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UpdatedUserId" class="control-label"></label>
        <input asp-for="UpdatedUserId" class="form-control" />
        <span asp-validation-for="UpdatedUserId" class="text-danger"></span>
    </div>
</div>

