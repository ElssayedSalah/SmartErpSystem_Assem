
@model BusinessLayer.Models.Financial.AccountModel
@{ 

    ViewBag.Title = @_Localization.GetLocalizedHtmlString("UpdateAccount");
    Layout = null;
    }
@using (Html.BeginForm("EditAccount", null, FormMethod.Post, new { id = "AccountsForm" }))
{
    @Html.AntiForgeryToken()
    <div class="portlet light form-fit" style=" padding: 0px !important">
        <div class="main-sec-title">
            <h3>
                <i class="fas fa-file-invoice-dollar"></i>
                @ViewBag.Title
            </h3>
        </div>
        <div class="portlet-body form">
            @Html.Partial("Account_CreateOrUpdate", Model)
        </div>
    </div>}