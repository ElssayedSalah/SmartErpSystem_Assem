
@model BusinessLayer.Models.Financial.AccountModel

@{
    ViewData["Title"] = _Localization.GetLocalizedHtmlString("ChartOfAccounts");
    Layout = "_AdminLayout2";
}

<div class="row">
    <div class="col-md-12">
        <div class="portlet light form-fit">
            <div class="row pt-1">
                <div class="col-lg-8 col-md-6 col-sm-8"><h5><i class="fa fa-list p-1"></i> @_Localization.GetLocalizedHtmlString("ChartOfAccounts")</h5></div>
                <div class="col-lg-4 col-md-6 col-sm-4">
                    <button type="button" class="btn btn-info float-end" onclick="NewAccount(this);"><i class="fa fa-plus"></i>  @_Localization.GetLocalizedHtmlString("CreateNew")</button>

                    <button type="button" id="BtnSave" style="display:none" class="btn btn-info float-end" onclick="SaveAccount(this);"><i class="fa fa-save"></i>  @_Localization.GetLocalizedHtmlString("Save")</button>
                </div>
            </div>

            <div class="portlet-body form">
                <div class="form-horizontal">
                    <div class="form-body">
                        <div class="portlet-body">
                            <div class="row">
                                <div class="col-md-5" style="height:100vh;overflow-y:scroll">
                                    @Html.Partial("_Tree")
                                </div>
                                <div class="col-md-7" id="CreateOrUpdatePnl">

                                </div>
                            </div>

                            <ul id="menu">
                                <li id="createMenu"><span action="create" class='icon'></span><i class="fa fa-plus"></i>@_Localization.GetLocalizedHtmlString("CreateNewAccount")</li>

                                <li><span action="edit" class='icon'></span><i class="fa fa-pencil-alt"></i>@_Localization.GetLocalizedHtmlString("Edit")</li>

                                <li><span action="delete" class='icon'></span><i class="fa fa-times"></i>@_Localization.GetLocalizedHtmlString("Delete")</li>

                                <li><span action="DeleteSub" class='icon'></span><i class="fa fa-times"></i>@_Localization.GetLocalizedHtmlString("DeleteSubAccounts") </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="treelist"></div>
</div>

<script src="~/AdminLayout2/assets/libs/jquery/jquery.min.js"></script>
@section Scripts {
    <script>
   var onInit ;
    function SaveAccount(e) {
        $(e).find(".fa").addClass("fa-spin").addClass("fa-spinner").removeClass("fa-save");
        var frm = $("#AccountsForm")[0];
        var SaveUrl = $(frm).attr("action");
        console.log(frm)
        if (true) {
           /* $(frm).valid()*/
            $.ajax({
                url: SaveUrl,
                type: "Post",
                datatype: "json",
                data: convertFormToObject(frm),
                success: function (data) {
                    debugger
                    if (data.IsSaved) {
                        //alert(data.Message);
                        ShowSuccessMessege(data.Message);
                        var tree = $("#treelist").data("kendoTreeList");
                        tree.dataSource.read();
                        onInit = data.Value;
                    }
                    else {
                        //alert(data.Message);
                        ShowErrorMessege(data.Message)
                    }
                    $(e).find(".fa-spin").removeClass("fa-spin").removeClass("fa-spinner").addClass("fa-save");
                },
                error: function (q) {
                    $(e).find(".fa-spin").removeClass("fa-spin").removeClass("fa-spinner").addClass("fa-save");
                }
            });
        }
        else {
            $(e).find(".fa-spin").removeClass("fa-spin").removeClass("fa-spinner").addClass("fa-save");
        }
    }
    function NewAccount() {
        GetAccountEditor("@Url.Action("CreateAccount")");
    }
    function GetAccountEditor(Url) {
        $("#CreateOrUpdatePnl").html('<div class="text-center"><i class="fa fa-spin fa-spinner"></i></div>');
         $.ajax({
             url: Url,
                type: "Get",
                datatype: "json",
                 success: function (data) {
                    $("#CreateOrUpdatePnl").html(data);
                    $("#BtnSave").show();
                }
            });
    }
    function onTreeBound(e) {

       $("tr").click(function () {
           setTimeout(function () {
                var tv = $('#treelist').data('kendoTreeList');
                selected = tv.select(),
                    item = tv.dataItem(selected);
               GetAccountEditor("/ChartOfAccounts/EditAccount/" + item.id);

            }, 200);
       });

        if (onInit) {
            $("#" + onInit).closest("tr").click();
        }
        else {
             $(".k-treelist-group").eq(0).click();
        }
    }

        var treeReadUrl = "@Url.Action("ListAccountsTree", "ChartOfAccounts")";
        var nameColStr = "Name";
        var accountColStr = "AccountCode";
        $("#menu").kendoContextMenu({
            // Listen to right-clicks on the TreeList container.
            target: "#treelist",
            // Show when a row is clicked.
            filter: "tbody > tr,table",
            open: function (e) {
                //var row = $(e.target);
                //var dataItem = $("#treelist").data("kendoTreeList").dataItem(row);
            },
            // Handle the item clicks.
            select: function (e) {
                var action = $(e.item).find(".icon").attr("action");
                var row = $(e.target);
                var dataItem = $("#treelist").data("kendoTreeList").dataItem(row);
                if (action == "create") {
                    if (dataItem) {
                        if (!dataItem.LastLevelInTree) {
                            GetAccountEditor("/ChartOfAccounts/CreateAccount?ParentId=" + dataItem.id);
                        }
                        else {
                            GetAccountEditor("/ChartOfAccounts/CreateAccount?ParentId=" + dataItem.parentId);
                        }
                    }
                    else {
                        GetAccountEditor("/ChartOfAccounts/CreateAccount");
                    }
                }
                else if (action == "edit") {
                    GetAccountEditor("/ChartOfAccounts/EditAccount/" + dataItem.id);
                }
                else if (action == "delete") {                    
                    DeleteAccountWithConfirmationDailog(dataItem.id,"ChartOfAccounts","DeleteAccount")
                }
                else if (action == "DeleteSub") {
                    DeleteAccountWithConfirmationDailog(dataItem.id, "ChartOfAccounts","DeleteAccountSub")

                }
            }
        });


    </script>

}